# Brasaland API environment (copy to .env and adjust)
SECRET_KEY=brasaland-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_API_KEY=
EMAIL_FROM=Brasaland <onboarding@resend.dev>
FRONTEND_URL=http://127.0.0.1:3004

# Supabase / PostgreSQL for inventory ORM (SQLModel). TinyDB remains for auth users.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=require
